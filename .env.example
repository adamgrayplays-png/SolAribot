# =============================================================================
# SolAribot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
#   cp .env.example .env
#
# NEVER commit .env files to version control!
# =============================================================================

# --- Solana RPC Endpoints ---
# Primary RPC (required)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Fallback RPCs (comma-separated, optional)
SOLANA_RPC_FALLBACKS=https://solana-api.projectserum.com,https://rpc.ankr.com/solana
# WebSocket endpoint (optional, derived from RPC_URL if not set)
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# --- Wallet ---
# Base58-encoded private key for the trading wallet
# Generate with: solana-keygen grind --starts-with arb:1
WALLET_PRIVATE_KEY=
# Public key of the trading wallet (derived, for reference)
WALLET_PUBLIC_KEY=

# --- Database ---
# PostgreSQL connection string for persistent storage
DATABASE_URL=postgresql://solAribot:password@localhost:5432/solAribot
# Redis connection string for caching and real-time data
REDIS_URL=redis://localhost:6379

# --- Arbitrage Engine ---
# Minimum profit threshold in SOL (trades below this are ignored)
MIN_PROFIT_THRESHOLD=0.001
# Maximum position size in SOL per trade
MAX_POSITION_SIZE=10.0
# Daily loss limit in SOL (bot stops trading if exceeded)
DAILY_LOSS_LIMIT=1.0
# Slippage tolerance (basis points, e.g., 50 = 0.5%)
SLIPPAGE_BPS=50

# --- Dashboard ---
# Port for the dashboard web server
DASHBOARD_PORT=3000
# Dashboard authentication (optional)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# --- Monitoring ---
# Discord webhook URL for alerts
DISCORD_WEBHOOK_URL=
# Telegram bot token (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
LOG_LEVEL=info
# Comma-separated: trace,debug,info,warn,error